<header class="site-header dark">
  <div class="wrap">
    <a class="brand" href="index.html" aria-label="Sunprint Studio, home"><span aria-hidden="true">sunpr<span class="i">ı</span>nt</span></a>
    <nav class="nav" aria-label="Main"><ul><li><a href="index.html">Home</a></li><li><a href="work.html">Work</a></li><li><a href="about.html">About</a></li><li><a href="services.html" aria-current="page">Services</a></li><li><a href="contact.html">Contact</a></li></ul></nav>
