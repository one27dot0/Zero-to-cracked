<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sunprint Studio | Photographs made with daylight</title>
<meta name="description" content="Sunprint is a small photography studio for portraits, weddings, and editorial work, shot in natural light.">
<meta name="theme-color" content="#0F2E78">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%230F2E78'/%3E%3Ccircle cx='16' cy='16' r='9' fill='%23FFC72C'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;700&family=Syne:wght@700;800&display=swap" rel="stylesheet">
<style>
:root{
  --white:#FFFFFF; --paper:#EDF2FB; --sky:#A9C1EE; --prussian:#0F2E78; --night:#081A4A; --sun:#FFC72C;
  --display:'Syne','Arial Black',system-ui,sans-serif;
  --body:'Hanken Grotesk',system-ui,-apple-system,'Segoe UI',Roboto,Arial,sans-serif;
  --pad:clamp(1.25rem,5vw,4rem);
}
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{margin:0;background:var(--white);color:var(--night);font:400 1.125rem/1.65 var(--body);-webkit-font-smoothing:antialiased}
img,svg{max-width:100%}
a{color:inherit}
h1,h2,h3{font-family:var(--display);color:var(--prussian);margin:0;font-weight:700;letter-spacing:-.02em;line-height:1.08;overflow-wrap:break-word}
h2{font-size:clamp(1.8rem,3.6vw,3rem)}
h3{font-size:1.3rem}
p{margin:0 0 1rem}
:focus-visible{outline:3px solid var(--prussian);outline-offset:3px}
.dark :focus-visible{outline-color:var(--sun)}
.dark{background:var(--prussian);color:#fff}
.dark h1,.dark h2,.dark h3{color:#fff}
.paper{background:var(--paper)}
.wrap{width:100%;max-width:78rem;margin-inline:auto;padding-inline:var(--pad)}
.section{padding-block:clamp(3.5rem,8vw,7rem)}
.skip{position:absolute;left:1rem;top:-4rem;background:var(--sun);color:var(--night);padding:.6rem 1rem;font-weight:700;z-index:10}
.skip:focus{top:1rem}

/* wordmark: the dot of the i is the sun */
.brand{font-family:var(--display);font-weight:800;letter-spacing:-.035em;text-decoration:none;color:inherit;line-height:1;display:inline-block}
.brand .i{position:relative;display:inline-block}
.brand .i::after{content:"";position:absolute;left:50%;top:var(--dot-top,.06em);width:.27em;height:.27em;margin-left:-.135em;border-radius:50%;background:var(--sun)}

/* header + nav */
.site-header .wrap{display:flex;align-items:center;justify-content:space-between;gap:1rem 2rem;flex-wrap:wrap;padding-block:1.4rem}
.site-header .brand{font-size:1.75rem}
.nav ul{display:flex;flex-wrap:wrap;gap:.25rem clamp(1rem,2.5vw,2rem);list-style:none;margin:0;padding:0}
.nav a{display:inline-block;padding:.3rem 0;text-decoration:none;font-weight:600;font-size:1rem;border-bottom:3px solid transparent}
.nav a:hover{border-bottom-color:var(--sky)}
.nav a[aria-current="page"]{border-bottom-color:var(--sun)}

/* buttons + links */
.btn{display:inline-block;padding:.85em 1.6em;font:700 1rem/1.2 var(--body);text-decoration:none;border:2px solid transparent;border-radius:999px;cursor:pointer;transition:background-color .15s,color .15s,border-color .15s}
.btn-sun{background:var(--sun);color:var(--night);border-color:var(--sun)}
.btn-sun:hover{background:#fff;border-color:#fff}
.btn-line{color:#fff;border-color:#fff}
.btn-line:hover{background:#fff;color:var(--prussian)}
.btn-blue{background:var(--prussian);color:#fff;border-color:var(--prussian)}
.btn-blue:hover{background:var(--night);border-color:var(--night)}
.actions{display:flex;flex-wrap:wrap;gap:.9rem}
.textlink{font-weight:700;color:var(--prussian);text-decoration:underline;text-decoration-thickness:3px;text-underline-offset:.25em;text-decoration-color:var(--sun)}
.textlink:hover{text-decoration-color:var(--prussian)}

/* hero (home) */
.hero{position:relative;overflow:hidden}
.hero .wrap{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:clamp(2rem,5vw,5rem);align-items:center;padding-block:clamp(1.5rem,5vw,4.5rem) clamp(3rem,6vw,5.5rem)}
.hero h1{font-size:clamp(2.1rem,4.6vw,3.9rem);font-weight:700;letter-spacing:-.035em;line-height:1.02;margin-bottom:1.5rem;overflow-wrap:normal}
.lead{font-size:1.2rem;max-width:34rem}
.dark .lead{color:var(--paper)}
.hero .lead{margin-bottom:2rem}
.hero-art{position:relative;justify-self:end;width:100%;max-width:32rem;aspect-ratio:1/1.02}
.hero-art .sun{position:absolute;width:72%;aspect-ratio:1;border-radius:50%;background:var(--sun);right:-6%;top:-2%}
.hero-art .print{position:absolute;left:0;bottom:0;width:70%;background:#fff;padding:.8rem .8rem 1rem;color:var(--night)}
.hero-art .print .frame{flex:none;aspect-ratio:4/5}

/* inner-page hero */
.page-hero{position:relative;overflow:hidden}
.page-hero .wrap{position:relative;padding-block:clamp(2rem,6vw,5rem) clamp(4.5rem,9vw,8rem)}
.page-hero .copy{max-width:min(40rem,62%)}
.page-hero h1{font-size:clamp(2.1rem,4.8vw,4rem);font-weight:700;letter-spacing:-.035em;line-height:1.04;margin-bottom:1.25rem;overflow-wrap:normal}
.page-hero .lead{margin:0}
.page-hero .sun,.hero .sun{border-radius:50%;background:var(--sun)}
.page-hero .sun{position:absolute;width:clamp(9rem,25vw,22rem);aspect-ratio:1;right:var(--sun-r,6%);top:var(--sun-t,auto);bottom:var(--sun-b,-24%)}
@media (prefers-reduced-motion:no-preference){
  .hero-art .sun{animation:rise 1.9s cubic-bezier(.2,.75,.25,1) both}
  @keyframes rise{from{transform:translateY(60%)}to{transform:none}}
}

/* photographs (plates) */
.plate{margin:0;display:flex;flex-direction:column;min-width:0}
.frame{position:relative;flex:1 1 auto;min-height:0;background:var(--paper);overflow:hidden}
.frame svg,.frame img{position:absolute;inset:0;width:100%;height:100%;display:block;object-fit:cover}
.plate figcaption{padding-top:.7rem;font-size:.95rem;line-height:1.4}
.plate figcaption strong{display:block;font:700 1.05rem/1.3 var(--display);color:var(--prussian)}
.dark .plate figcaption strong{color:var(--prussian)}
.solo .frame{flex:none;aspect-ratio:4/5}
.grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:clamp(1rem,2vw,1.75rem);grid-auto-rows:clamp(15rem,30vw,27rem)}
.grid .plate{height:100%}
.grid .a{grid-column:1 / span 7;grid-row:1}
.grid .b{grid-column:8 / span 5;grid-row:1 / span 2}
.grid .c{grid-column:1 / span 7;grid-row:2}
.grid.flip .b{grid-column:1 / span 5}
.grid.flip .a{grid-column:6 / span 7}
.grid.flip .c{grid-column:6 / span 7}

/* section headers + lists */
.section-head{display:flex;justify-content:space-between;align-items:end;gap:1rem 2rem;flex-wrap:wrap;margin-bottom:clamp(1.5rem,3vw,2.75rem)}
.kinds{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(1.5rem,3vw,2.5rem);list-style:none;margin:0;padding:0}
.kinds.three{grid-template-columns:repeat(3,minmax(0,1fr))}
.kinds li{border-top:4px solid var(--prussian);padding-top:1rem}
.kinds h3{margin-bottom:.45rem}
.kinds p{margin:0}
.split{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:clamp(2rem,5vw,5rem);align-items:center}
.split.rev{grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr)}
.split h2{margin-bottom:1.25rem}
.statement h2{font-size:clamp(2rem,4.6vw,3.9rem);letter-spacing:-.03em;line-height:1.02}
.prose p{max-width:36rem}

/* series (work page) */
.jump{border-bottom:2px solid var(--paper)}
.jump ul{display:flex;flex-wrap:wrap;gap:.4rem 1.75rem;list-style:none;margin:0;padding-block:1.1rem}
.jump a{font-weight:700;color:var(--prussian);text-decoration:none;border-bottom:3px solid var(--sun)}
.jump a:hover{border-bottom-color:var(--prussian)}
.series-head{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:1rem 3rem;align-items:end;margin-bottom:clamp(1.5rem,3vw,2.5rem)}
.series-head p{margin:0;max-width:30rem}
.series{scroll-margin-top:1rem}

/* definition list */
.notes{display:grid;grid-template-columns:minmax(0,13rem) minmax(0,1fr);margin:0;max-width:46rem}
.notes dt,.notes dd{margin:0;padding:.95rem 0;border-top:2px solid var(--sky)}
.notes dt{font-weight:700;color:var(--prussian)}
.notes dt:last-of-type,.notes dd:last-of-type{border-bottom:2px solid var(--sky)}

/* services */
.service{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.35fr) auto;gap:1.25rem clamp(1.5rem,4vw,3.5rem);padding-block:clamp(1.75rem,3.5vw,2.75rem);border-top:4px solid var(--prussian);align-items:start}
.service:last-of-type{border-bottom:4px solid var(--prussian)}
.service h3{font-size:clamp(1.5rem,2.6vw,2.2rem);margin-bottom:.4rem}
.price{font-weight:700;font-size:1.15rem;margin:0}
.service p{max-width:34rem}
.service ul{margin:.6rem 0 0;padding-left:1.2rem}
.service li{margin-bottom:.2rem}
.steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(1.5rem,3vw,2.5rem);list-style:none;margin:0;padding:0;counter-reset:step}
.steps li{counter-increment:step;border-top:4px solid var(--sun);padding-top:1rem}
.steps li::before{content:counter(step);display:block;font:800 2.6rem/1 var(--display);color:var(--sun);margin-bottom:.7rem}
.steps h3{margin-bottom:.4rem}
.steps p{margin:0;color:var(--paper)}
.faq{max-width:50rem}
.faq details{border-top:3px solid var(--prussian);padding:1.1rem 0}
.faq details:last-child{border-bottom:3px solid var(--prussian)}
.faq summary{cursor:pointer;font:700 1.2rem/1.3 var(--display);color:var(--prussian);list-style:none;display:flex;justify-content:space-between;gap:1rem}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:"+";font-size:1.7rem;line-height:1;flex:none}
.faq details[open] summary::after{content:"\2212"}
.faq p{margin:.8rem 0 0;max-width:42rem}

/* contact */
.contact-grid{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,.7fr);gap:clamp(2.5rem,6vw,6rem);align-items:start}
.field{margin-bottom:1.35rem}
.field-row{display:grid;grid-template-columns:1fr 1fr;gap:0 1.35rem}
label{display:block;font-weight:700;margin-bottom:.4rem;color:var(--prussian)}
input,select,textarea{width:100%;font:inherit;color:var(--night);background:#fff;padding:.85rem 1rem;border:2px solid var(--prussian);border-radius:0}
textarea{min-height:10rem;resize:vertical}
.optional{font-weight:400;color:var(--night)}
.details h2{font-size:1.35rem;margin-bottom:.25rem}
.details div{margin-bottom:1.6rem}
.details p{margin:0}
.details .big{font:700 1.3rem/1.3 var(--display);color:var(--prussian);overflow-wrap:anywhere}
.sunbox{background:var(--sun);padding:1.4rem 1.6rem;color:var(--night)}
.sunbox h2{margin-bottom:.4rem}
.sunbox p{margin:0}

/* yellow band */
.band{background:var(--sun);color:var(--night)}
.band .wrap{display:flex;justify-content:space-between;align-items:center;gap:1.5rem 3rem;flex-wrap:wrap;padding-block:clamp(2.5rem,6vw,4.5rem)}
.band h2{margin-bottom:.4rem;font-size:clamp(1.9rem,4vw,3.2rem)}
.band p{margin:0;font-size:1.15rem}

/* footer */
.site-footer{background:var(--night);color:var(--paper)}
.site-footer .wrap{padding-block:clamp(3rem,6vw,5rem) 2rem}
.site-footer .brand{font-size:clamp(3.2rem,11vw,8.5rem);color:#fff;--dot-top:.04em}
.site-footer .tag{margin:1rem 0 clamp(2rem,4vw,3.5rem);font-size:1.2rem}
.foot-cols{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2rem;padding-top:2rem;border-top:2px solid var(--prussian)}
.foot-cols h2{font-size:1.05rem;color:#fff;margin-bottom:.6rem}
.foot-cols ul{list-style:none;margin:0;padding:0}
.foot-cols li{margin-bottom:.3rem}
.foot-cols p{margin:0 0 .3rem}
.foot-cols a{text-decoration-color:var(--sky);text-underline-offset:.2em}
.foot-cols a:hover{color:var(--sun)}
.legal{margin:3rem 0 0;font-size:.9rem;color:var(--sky)}

/* responsive */
@media (max-width:1000px){
  .kinds{grid-template-columns:repeat(2,minmax(0,1fr))}
  .steps{grid-template-columns:repeat(2,minmax(0,1fr))}
  .service{grid-template-columns:minmax(0,1fr) minmax(0,1.4fr)}
  .service .btn{grid-column:2;justify-self:start}
}
@media (max-width:820px){
  .hero .wrap{grid-template-columns:1fr}
  .hero-art{justify-self:start;max-width:28rem}
  .split,.split.rev,.contact-grid,.series-head{grid-template-columns:1fr}
  .kinds.three{grid-template-columns:1fr}
  .foot-cols{grid-template-columns:1fr}
  .page-hero .copy{max-width:none}
  .page-hero .sun{top:auto;bottom:-3.5rem;right:-1.5rem;width:9.5rem}
  .grid{grid-template-columns:1fr;grid-auto-rows:auto}
  .grid .a,.grid .b,.grid .c,.grid.flip .a,.grid.flip .b,.grid.flip .c{grid-column:auto;grid-row:auto}
  .grid .plate{height:auto}
  .grid .frame{flex:none;aspect-ratio:4/3}
  .grid .b .frame{aspect-ratio:4/5}
  .service{grid-template-columns:1fr}
  .service .btn{grid-column:auto}
}
@media (max-width:560px){
  .kinds,.steps,.field-row{grid-template-columns:1fr}
  .notes{grid-template-columns:1fr}
  .notes dt{border-bottom:0;padding-bottom:0}
  .notes dd{border-top:0;padding-top:.15rem}
  .notes dt:last-of-type{border-bottom:0}
}
</style>
</head>
